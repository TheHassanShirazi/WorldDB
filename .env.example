# Copy to .env.local, or let scripts/setup-atlas.sh fill it in for you.

# Full Atlas connection string, password already substituted in.
# Atlas hands you one with a <db_password> placeholder — replace it.
MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Atlas connection strings carry no database name, so it is named separately
# and passed to mongoose as dbName.
MONGODB_DB=worlddb
